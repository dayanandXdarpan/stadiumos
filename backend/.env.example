# =============================================================================
# StadiumOS — Environment Variables Template
# =============================================================================

# ---- Google Cloud Platform ----
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GCP_PROJECT_ID=stadiumos-demo

# ---- Pub/Sub ----
PUBSUB_TOPIC=stadium-events
PUBSUB_SUBSCRIPTION=stadium-events-sub

# ---- Firestore ----
FIRESTORE_COLLECTION=stadium-state
FIRESTORE_LEDGER_COLLECTION=agent-ledger

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Gemini / LangChain ----
GEMINI_API_KEY=your-gemini-api-key-here
LANGCHAIN_TRACING_V2=false

# ---- App Config ----
# Set to true to run without any cloud dependencies (fully local)
EDGE_MODE=false

# Backend API port (Cloud Run uses 8080)
PORT=8000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://your-firebase-app.web.app

# ---- API Auth ----
# Bearer token for mutation endpoints (trigger/storm, trigger/surge, etc.)
# Default is "stadiumos-demo-token" if not set — change this in production!
API_TOKEN=stadiumos-demo-token

# ---- Flutter / FCM ----
# Firebase Server Key for sending push notifications from backend
FCM_SERVER_KEY=your-fcm-server-key-here

# ---- Agent Config ----
CPS_THRESHOLD=0.75
CPS_STORM_MULTIPLIER=0.75
AGENT_TICK_INTERVAL=3
SENTIMENT_TICK_INTERVAL=15
SIMULATION_COUNT=500
