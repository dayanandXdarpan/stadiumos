# =============================================================================
# StadiumOS Admin — Environment Variables Template
# Copy this file to admin/.env.local and fill in your values
# =============================================================================

# ---- Backend Connection ----
# For local development
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# For Cloud Run / production (replace with your backend Cloud Run URL)
# NEXT_PUBLIC_API_URL=https://stadiumos-backend-xxxxxx-uc.a.run.app
# NEXT_PUBLIC_WS_URL=wss://stadiumos-backend-xxxxxx-uc.a.run.app/ws

# ---- API Auth ----
# Must match the API_TOKEN set in the backend .env
NEXT_PUBLIC_API_TOKEN=stadiumos-demo-token
