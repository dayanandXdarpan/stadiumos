# =============================================================================
# StadiumOS — Environment Variables Template
# Copy this file to backend/.env and fill in your values
# =============================================================================

# ---- Google Cloud Platform ----
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GCP_PROJECT_ID=stadiumos-demo

# ---- Pub/Sub ----
PUBSUB_TOPIC=stadium-events
PUBSUB_SUBSCRIPTION=stadium-events-sub

# ---- Firestore ----
FIRESTORE_COLLECTION=stadium-state
FIRESTORE_LEDGER_COLLECTION=agent-ledger

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Gemini / LangChain ----
GEMINI_API_KEY=your-gemini-api-key-here
LANGCHAIN_TRACING_V2=false

# ---- App Config ----
# Set to true to run without any cloud dependencies (fully local)
EDGE_MODE=false

# Backend API port (Cloud Run uses 8080)
PORT=8000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://your-firebase-app.web.app

# ---- Flutter / FCM ----
# Firebase Server Key for sending push notifications from backend
FCM_SERVER_KEY=your-fcm-server-key-here

# ---- Agent Config ----
CPS_THRESHOLD=0.75
CPS_STORM_MULTIPLIER=0.75
AGENT_TICK_INTERVAL=3
SENTIMENT_TICK_INTERVAL=15
SIMULATION_COUNT=500
