# ── StadiumOS root .dockerignore ──────────────────────────────────────
# Keeps the Cloud Build context small and secure.
# ──────────────────────────────────────────────────────────────────────

# Git
.git
.github

# Node modules (rebuilt inside container)
admin/node_modules
fan-app/node_modules

# Next.js build cache (rebuilt inside container)
admin/.next

# Python virtualenv
backend/.venv
backend/venv
backend/__pycache__
backend/.pytest_cache
backend/tests/__pycache__

# Dev databases
backend/edge_sync.db

# Environment / secrets
**/.env
**/.env.local
**/service-account.json
**/*-firebase-adminsdk-*.json

# Fan app (Flutter — not in this container)
fan-app/

# IDE / OS
.vscode
.idea
*.swp
.DS_Store
Thumbs.db

# Documentation (not needed in image)
*.md
!admin/README.md
stadiumos_architecture_spec.md
stadiumos_testing_architecture.md
stadiumosprd.md
post_match_debrief.md

# Docker files (avoid recursive context)
docker-compose.yml
